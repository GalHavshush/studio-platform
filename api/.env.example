# Copy to .env and adjust. Default is the local Postgres from `docker compose up -d` (repo root).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/postgres
# Signs login tokens. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
