# Copy to .env (git-ignored). Restart `npx expo start` after changing it.
# The simulator reaches the Mac at localhost; a real phone needs the Mac's address on your Wi-Fi
# (find it with `ipconfig getifaddr en0`) and the API started with `uv run fastapi dev --host 0.0.0.0`.
EXPO_PUBLIC_API_URL=http://localhost:8000
